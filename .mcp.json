{
  "mcpServers": {
    "youtube-studio": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/pauling-ai/youtube-mcp-server@ec13ee51d4be48ad84cced79fee7d78f9b2f68f8",
        "--with",
        "mcp>=1.26,<2",
        "youtube-studio-mcp"
      ],
      "env": {
        "YOUTUBE_MCP_CLIENT_SECRET": "${YOUTUBE_MCP_CLIENT_SECRET:-}",
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY:-}"
      }
    }
  }
}
